+static void __an7581_phy_pkg_tr_write(struct phy_device *phydev,
+				      unsigned int offset, u8 ch, u8 node,
+				      u8 data, u32 val)
+{
+	u16 cmd = BIT(15) | ((ch & 0x3) << 11) | ((node & 0xf) << 7) |
+		  ((data & 0x3f) << 1);
+
+	__phy_package_write(phydev, offset, 0x11, val & 0xffff);
+	__phy_package_write(phydev, offset, 0x12, val >> 16);
+	__phy_package_write(phydev, offset, 0x10, cmd);
+}
+
+static int __an7581_phy_cal_step(struct phy_device *phydev)
+{
+	int ret, tries;
+
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_AD_CALIN, MTK_PHY_DA_CALIN_FLAG);
+	for (tries = 0; tries < 100; tries++) {
+		usleep_range(20, 40);
+		ret = __phy_package_read_mmd(phydev, 0, MDIO_MMD_VEND1,
+					     MTK_PHY_RG_AD_CAL_CLK);
+		if (ret < 0) {
+			__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+						MTK_PHY_RG_AD_CALIN, 0);
+			return ret;
+		}
+		if (ret & MTK_PHY_DA_CAL_CLK)
+			break;
+	}
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_AD_CALIN, 0);
+	if (!(ret & MTK_PHY_DA_CAL_CLK))
+		return -ETIMEDOUT;
+
+	ret = __phy_package_read_mmd(phydev, 0, MDIO_MMD_VEND1,
+				     MTK_PHY_RG_AD_CAL_COMP);
+	if (ret < 0)
+		return ret;
+
+	return (ret >> 8) & 0x1;
+}
+
+static void __an7581_phy_cal_rext(struct phy_device *phydev)
+{
+	int init_out, out, step, val = 0x20;
+	int orig_e0;
+
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x1110);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1, 0x0e1, 0x0000);
+	orig_e0 = __phy_package_read_mmd(phydev, 0, MDIO_MMD_VEND1,
+					 MTK_PHY_RG_ANA_CAL_RG5);
+	if (orig_e0 < 0)
+		orig_e0 = 0;
+
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG5, val);
+	init_out = __an7581_phy_cal_step(phydev);
+	if (init_out < 0) {
+		__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG5,
+					(orig_e0 & 0xffc0) | 0x20);
+		goto out_disable;
+	}
+
+	step = init_out ? -1 : 1;
+	while (val != 0x3f && val != 0x00) {
+		val += step;
+		__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG5, val);
+		out = __an7581_phy_cal_step(phydev);
+		if (out < 0) {
+			__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+						MTK_PHY_RG_ANA_CAL_RG5,
+						(orig_e0 & 0xffc0) | 0x20);
+			goto out_disable;
+		}
+		if (out != init_out)
+			goto apply;
+	}
+	val = 0x20;
+
+apply:
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG5, (val << 8) | val);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND2,
+				MTK_PHY_RG_BG_RASEL, (val >> 3) & 0x7);
+
+out_disable:
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+}
+
+static void __an7581_phy_cal_port(struct phy_device *phydev,
+				  unsigned int offset)
+{
+	static const u16 r45_rg0[4] = { 0x1101, 0x1100, 0x1100, 0x1100 };
+	static const u16 r45_rg1[4] = { 0x0000, 0x1000, 0x0100, 0x0010 };
+	static const u16 tx_dd[4]   = { 0x1000, 0x0100, 0x0010, 0x0001 };
+	static const u16 vos_rg0[4] = { 0x0101, 0x0100, 0x0100, 0x0100 };
+	static const u16 vos_rg1[4] = { 0x0001, 0x1001, 0x0101, 0x0011 };
+	static const u16 amp_rg0[4] = { 0x1101, 0x1100, 0x1100, 0x1100 };
+	static const u16 amp_rg1[4] = { 0x0001, 0x1001, 0x0101, 0x0011 };
+	static const u16 amp_reg[4] = {
+		MTK_PHY_TXVLD_DA_RG,
+		MTK_PHY_TX_I2MPB_TEST_MODE_B1,
+		MTK_PHY_TX_I2MPB_TEST_MODE_C1,
+		MTK_PHY_TX_I2MPB_TEST_MODE_D1,
+	};
+	static const u16 amp_copy_reg[4] = {
+		MTK_PHY_TX_I2MPB_TEST_MODE_A2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_B2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_C2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_D2,
+	};
+	int orig_bmcr, orig_145, reg_val;
+	unsigned int pair, i;
+
+	__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+			    MTK_PHY_PAGE_STANDARD);
+	orig_bmcr = __phy_package_read(phydev, offset, MII_BMCR);
+	if (orig_bmcr < 0)
+		orig_bmcr = BMCR_PDOWN;
+	__phy_package_write(phydev, offset, MII_BMCR, BMCR_SPEED1000 | BMCR_FULLDPLX);
+
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND2, 0x100, 0xc000);
+	orig_145 = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x145);
+	if (orig_145 < 0)
+		orig_145 = 0;
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x145, 0x1010);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x185, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x0fb, 0x0100);
+
+	if (offset == 0)
+		__an7581_phy_cal_rext(phydev);
+
+	/* R45 termination calibration across pairs A..D */
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x1100);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x0e1, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x1100);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1, 0x0e1, 0x0000);
+
+	for (pair = 0; pair < 4; pair++) {
+		int e0_hi, init_out, out, step, idx = 0x20;
+		u16 r45_val = 0x20;
+		u16 dst_reg = (pair < 2) ? 0x174 : 0x175;
+
+		e0_hi = __phy_package_read_mmd(phydev, 0, MDIO_MMD_VEND1,
+					       MTK_PHY_RG_ANA_CAL_RG5);
+		e0_hi = (e0_hi < 0) ? 0 : (e0_hi & 0xffc0);
+		__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG5, e0_hi | idx);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG0, r45_rg0[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG1, r45_rg1[pair]);
+
+		init_out = __an7581_phy_cal_step(phydev);
+		if (init_out >= 0) {
+			step = init_out ? -1 : 1;
+			while (idx != 0x3f && idx != 0x00) {
+				idx += step;
+				__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+							MTK_PHY_RG_ANA_CAL_RG5,
+							e0_hi | idx);
+				out = __an7581_phy_cal_step(phydev);
+				if (out < 0)
+					goto write_r45;
+				if (out != init_out)
+					break;
+			}
+			r45_val = idx ? an7581_zcal_to_r45_tbl[idx] : 0;
+		}
+write_r45:
+		reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1,
+						 dst_reg);
+		if (reg_val < 0)
+			reg_val = 0;
+		if (pair & 1)
+			reg_val = (reg_val & 0xff80) | r45_val | 0x0080;
+		else
+			reg_val = (reg_val & 0x80ff) | (r45_val << 8) | 0x8000;
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					dst_reg, reg_val);
+	}
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+
+	/* TX offset calibration across pairs A..D */
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0100);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0001);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0100);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0001);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x096, 0x8000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x03e, 0xf808);
+
+	for (pair = 0; pair < 4; pair++) {
+		u16 dst_reg = (pair < 2) ? MTK_PHY_RG_CR_TX_AMP_OFFSET_A_B :
+					   MTK_PHY_RG_CR_TX_AMP_OFFSET_C_D;
+		u16 shift = (pair & 1) ? 0 : 8;
+		u16 keep_mask = (pair & 1) ? 0xffc0 : 0xc0ff;
+		int init_out, out, step, tbl_idx;
+		u16 base_val, ofs_val;
+
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					0x0dd, tx_dd[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG0, vos_rg0[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG1, vos_rg1[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN0_A + pair, 0x8000);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN1_A + pair, 0x8000);
+
+		reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1,
+						 dst_reg);
+		base_val = (reg_val < 0) ? 0 : (reg_val & keep_mask);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					dst_reg, base_val);
+
+		init_out = __an7581_phy_cal_step(phydev);
+		if (init_out < 0)
+			continue;
+
+		step = init_out ? 1 : -1;
+		tbl_idx = 0x1f + step;
+		for (;;) {
+			ofs_val = an7581_tx_ofs_tbl[tbl_idx];
+			__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+						dst_reg,
+						base_val | (ofs_val << shift));
+			out = __an7581_phy_cal_step(phydev);
+			if (out < 0) {
+				__phy_package_write_mmd(phydev, offset,
+							MDIO_MMD_VEND1,
+							dst_reg, base_val);
+				break;
+			}
+			if (out != init_out || (ofs_val & ~0x20) == 0x1f)
+				break;
+			tbl_idx = (tbl_idx + step) & 0x3f;
+		}
+	}
+
+	for (i = 0; i < 8; i++)
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN0_A + i, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x03e, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x0dd, 0x0000);
+
+	/* TX amplitude calibration across pairs A..D */
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x1100);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0001);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x0e1, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x1100);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0001);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1, 0x0e1, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x03e, 0xf808);
+
+	for (pair = 0; pair < 4; pair++) {
+		u16 shift = (pair == 0) ? 10 : 8;
+		u16 keep_mask = (pair == 0) ? 0x03ff : 0xc0ff;
+		int init_out, out, step, val = 0x20;
+		u16 base_val;
+
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					0x0dd, tx_dd[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG0, amp_rg0[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_ANA_CAL_RG1, amp_rg1[pair]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN0_A + pair, 0x80f0);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN1_A + pair, 0x80f0);
+
+		reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1,
+						 amp_reg[pair]);
+		base_val = (reg_val < 0) ? 0x20 : (reg_val & keep_mask);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					amp_reg[pair],
+					base_val | (val << shift));
+
+		init_out = __an7581_phy_cal_step(phydev);
+		if (init_out < 0) {
+			__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+						amp_reg[pair],
+						base_val | (0x20 << shift));
+			break;
+		}
+
+		step = init_out ? -1 : 1;
+		while (val != 0x3f && val != 0x00) {
+			val += step;
+			__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+						amp_reg[pair],
+						base_val | (val << shift));
+			out = __an7581_phy_cal_step(phydev);
+			if (out < 0) {
+				__phy_package_write_mmd(phydev, offset,
+							MDIO_MMD_VEND1,
+							amp_reg[pair],
+							base_val | (0x20 << shift));
+				goto cleanup_amp;
+			}
+			if (out != init_out)
+				break;
+		}
+
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					amp_reg[pair], (val << shift) | val);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					amp_copy_reg[pair],
+					(val << shift) | val);
+	}
+
+cleanup_amp:
+	for (i = 0; i < 8; i++)
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					MTK_PHY_RG_DASN_DAC_IN0_A + i, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x03e, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x0dd, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG0, 0x0000);
+	__phy_package_write_mmd(phydev, 0, MDIO_MMD_VEND1,
+				MTK_PHY_RG_ANA_CAL_RG1, 0x0000);
+
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x096, 0x8000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x037, 0x0033);
+
+	reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x039);
+	if (reg_val >= 0)
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x039,
+					reg_val & ~0x4800);
+	reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND2, 0x107);
+	if (reg_val >= 0)
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND2, 0x107,
+					reg_val & ~0x1000);
+
+	reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x171);
+	if (reg_val < 0)
+		reg_val = 0;
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x171,
+				reg_val | 0x0180);
+
+	reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x039);
+	if (reg_val < 0)
+		reg_val = 0;
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x039,
+				reg_val | 0x2000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x039,
+				reg_val & ~0x2000);
+	usleep_range(10000, 12000);
+
+	reg_val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x171);
+	if (reg_val >= 0)
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x171,
+					reg_val & ~0x0180);
+
+	__phy_package_write(phydev, offset, MII_BMCR, orig_bmcr);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND2, 0x100, 0x0000);
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x145, orig_145);
+	for (i = 0; i < AN7581_PHY_COUNT; i++)
+		__phy_package_write_mmd(phydev, i, MDIO_MMD_VEND1, 0x015, 0x0000);
+	__phy_package_write(phydev, offset, MII_BMCR, BMCR_PDOWN);
+}
+
+static void __an7581_phy_tx_amp_comp(struct phy_device *phydev,
+				     unsigned int offset)
+{
+	static const u16 gbe_regs[4] = {
+		MTK_PHY_TXVLD_DA_RG,
+		MTK_PHY_TX_I2MPB_TEST_MODE_B1,
+		MTK_PHY_TX_I2MPB_TEST_MODE_C1,
+		MTK_PHY_TX_I2MPB_TEST_MODE_D1,
+	};
+	static const u16 tst_regs[4] = {
+		MTK_PHY_TX_I2MPB_TEST_MODE_A2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_B2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_C2,
+		MTK_PHY_TX_I2MPB_TEST_MODE_D2,
+	};
+	const struct an7581_phy_tx_amp_ofs *ofs = &an7581_phy_tx_amp_comp_tbl[offset];
+	u16 reg_gbe[4], reg_tst[4], r174, r175;
+	int gbe[4], tst[4], hbt[2], tbt[2], val;
+	unsigned int p;
+
+	for (p = 0; p < 4; p++) {
+		u16 shift = (p == 0) ? 10 : 8;
+
+		val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1,
+					     gbe_regs[p]);
+		reg_gbe[p] = (val < 0) ? 0 : val;
+		gbe[p] = ((reg_gbe[p] >> shift) & 0x3f) + ofs->gbe[p];
+
+		val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1,
+					     tst_regs[p]);
+		reg_tst[p] = (val < 0) ? 0 : val;
+		tst[p] = (reg_tst[p] & 0x3f) + ofs->tst[p];
+	}
+
+	if (gbe[0] < -3 || gbe[1] < -3 || gbe[2] < -3 || gbe[3] < -3) {
+		gbe[0] = 0x20;
+		gbe[1] = 0x20;
+		gbe[2] = 0x20;
+		gbe[3] = 0x20;
+	} else {
+		for (p = 0; p < 4; p++)
+			gbe[p] = max(gbe[p], 0);
+	}
+
+	if (tst[0] >= 0x43 || tst[1] >= 0x43 || tst[2] >= 0x43 || tst[3] >= 0x43) {
+		tst[0] = 0x20;
+		tst[1] = 0x20;
+		tst[2] = 0x20;
+		tst[3] = 0x20;
+	} else {
+		for (p = 0; p < 4; p++)
+			tst[p] = min(tst[p], 0x3f);
+	}
+
+	hbt[0] = ((reg_tst[0] >> 10) & 0x3f) + ofs->hbt_ab;
+	hbt[1] = ((reg_tst[1] >> 8) & 0x3f) + ofs->hbt_ab;
+	if (hbt[0] >= 0x43 || hbt[1] >= 0x43) {
+		hbt[0] = 0x20;
+		hbt[1] = 0x20;
+	} else {
+		hbt[0] = min(hbt[0], 0x3f);
+		hbt[1] = min(hbt[1], 0x3f);
+	}
+
+	tbt[0] = (reg_gbe[0] & 0x3f) + ofs->tbt_ab;
+	tbt[1] = (reg_gbe[1] & 0x3f) + ofs->tbt_ab;
+	if (tbt[0] >= 0x43 || tbt[1] >= 0x43) {
+		tbt[0] = 0x20;
+		tbt[1] = 0x20;
+	} else {
+		tbt[0] = min(tbt[0], 0x3f);
+		tbt[1] = min(tbt[1], 0x3f);
+	}
+
+	reg_gbe[0] = (reg_gbe[0] & 0x03c0) | (gbe[0] << 10) | tbt[0];
+	reg_gbe[1] = (reg_gbe[1] & 0xc0c0) | (gbe[1] << 8) | tbt[1];
+	reg_gbe[2] = (reg_gbe[2] & 0xc0ff) | (gbe[2] << 8);
+	reg_gbe[3] = (reg_gbe[3] & 0xc0ff) | (gbe[3] << 8);
+
+	reg_tst[0] = (reg_tst[0] & 0x03c0) | (hbt[0] << 10) | tst[0];
+	reg_tst[1] = (reg_tst[1] & 0xc0c0) | (hbt[1] << 8) | tst[1];
+	reg_tst[2] = (reg_tst[2] & 0xffc0) | tst[2];
+	reg_tst[3] = (reg_tst[3] & 0xffc0) | tst[3];
+
+	for (p = 0; p < 4; p++) {
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					gbe_regs[p], reg_gbe[p]);
+		__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1,
+					tst_regs[p], reg_tst[p]);
+	}
+
+	val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x174);
+	r174 = ((val < 0) ? 0 : val) | 0x8080;
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x174, r174);
+
+	val = __phy_package_read_mmd(phydev, offset, MDIO_MMD_VEND1, 0x175);
+	r175 = ((val < 0) ? 0 : val) | 0x8080;
+	__phy_package_write_mmd(phydev, offset, MDIO_MMD_VEND1, 0x175, r175);
+}
+
+static void __an7581_phy_normal_init_port(struct phy_device *phydev,
+					  unsigned int offset)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(an7581_phy_normal_cl45); i++)
+		__phy_package_write_mmd(phydev, offset,
+					an7581_phy_normal_cl45[i].devad,
+					an7581_phy_normal_cl45[i].reg,
+					an7581_phy_normal_cl45[i].val);
+
+	__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+			    MTK_PHY_PAGE_EXTENDED_52B5);
+	for (i = 0; i < ARRAY_SIZE(an7581_phy_normal_tr); i++)
+		__an7581_phy_pkg_tr_write(phydev, offset,
+					  an7581_phy_normal_tr[i].ch,
+					  an7581_phy_normal_tr[i].node,
+					  an7581_phy_normal_tr[i].data,
+					  an7581_phy_normal_tr[i].val);
+
+	__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+			    MTK_PHY_PAGE_EXTENDED_1);
+	__phy_package_write(phydev, offset, MTK_PHY_AUX_CTRL_AND_STATUS, 0x3a18);
+	__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+			    MTK_PHY_PAGE_STANDARD);
+}
+
+static void an7581_phy_probe_shared(struct phy_device *phydev)
+{
+	unsigned int offset, i;
+
+	phy_lock_mdio_bus(phydev);
+
+	for (offset = 0; offset < AN7581_PHY_COUNT; offset++) {
+		for (i = 0; i < ARRAY_SIZE(an7581_phy_cfg_cl45); i++)
+			__phy_package_write_mmd(phydev, offset,
+						an7581_phy_cfg_cl45[i].devad,
+						an7581_phy_cfg_cl45[i].reg,
+						an7581_phy_cfg_cl45[i].val);
+		for (i = 0; i < ARRAY_SIZE(an7581_phy_cfg_c22); i++)
+			__phy_package_write(phydev, offset,
+					    an7581_phy_cfg_c22[i].reg,
+					    an7581_phy_cfg_c22[i].val);
+
+		__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+				    MTK_PHY_PAGE_EXTENDED_52B5);
+		for (i = 0; i < ARRAY_SIZE(an7581_phy_cfg_tr); i++)
+			__an7581_phy_pkg_tr_write(phydev, offset,
+						  an7581_phy_cfg_tr[i].ch,
+						  an7581_phy_cfg_tr[i].node,
+						  an7581_phy_cfg_tr[i].data,
+						  an7581_phy_cfg_tr[i].val);
+		__phy_package_write(phydev, offset, MTK_EXT_PAGE_ACCESS,
+				    MTK_PHY_PAGE_STANDARD);
+	}
+
+	for (offset = 0; offset < AN7581_PHY_COUNT; offset++)
+		__an7581_phy_cal_port(phydev, offset);
+
+	for (offset = 0; offset < AN7581_PHY_COUNT; offset++) {
+		__an7581_phy_tx_amp_comp(phydev, offset);
+		__an7581_phy_normal_init_port(phydev, offset);
+	}
+
+	phy_unlock_mdio_bus(phydev);
+}
