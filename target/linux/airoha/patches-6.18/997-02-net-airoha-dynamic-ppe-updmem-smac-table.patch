From: grislux55 <jebchou.hg@gmail.com>
Subject: [PATCH] net: airoha: allocate PPE UPDMEM SMAC slots dynamically for IPv6

Unlike IPv4 FOE entries which embed the 6-byte source MAC inline, IPv6
FOE entries encode a 4-bit smac_id that hardware resolves through the
PPE UPDMEM table (slots 0..14; slot 0xf keeps the original SMAC).

Previously airoha_ppe_init_upd_mem() only programmed UPDMEM[port->id]
with the base GDM port MAC, and IPv6 offload always stored port->id in
smac_id. Whenever an upper interface such as a PON VLAN (e.g. pon0.2001)
or bridge used a cloned MAC address, IPv6 flows bound into PPE rewrote
egress packets to the base physical MAC, causing the ISP BRAS to drop
all offloaded IPv6 traffic once binding triggered.

Track the 15 usable UPDMEM slots in struct airoha_ppe, program all PPE
instances (waiting for PPE_UPDMEM_ACK_MASK after each write), and resolve or allocate
the matching UPDMEM slot for data->eth.h_source when preparing IPv6 FOE
entries.

Signed-off-by: grislux55 <jebchou.hg@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -736,6 +736,8 @@ struct airoha_gdm_port {
 #define AIROHA_RXD4_PPE_CPU_REASON	GENMASK(20, 16)
 #define AIROHA_RXD4_FOE_ENTRY		GENMASK(15, 0)
 
+#define AIROHA_PPE_SMAC_NUM		15
+
 struct airoha_ppe {
 	struct airoha_ppe_dev dev;
 	struct airoha_eth *eth;
@@ -751,6 +753,13 @@ struct airoha_ppe {
 	struct airoha_foe_stats *foe_stats;
 	dma_addr_t foe_stats_dma;
 
+	spinlock_t smac_lock;
+	struct {
+		u8 addr[ETH_ALEN];
+		bool valid;
+	} smac_table[AIROHA_PPE_SMAC_NUM];
+	u8 smac_next_slot;
+
 	struct dentry *debugfs_dir;
 };
 
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -558,6 +558,88 @@ static int airoha_ppe_pon_select_flow(st
 	return 0;
 }
 
+static void airoha_ppe_write_upd_mem(struct airoha_eth *eth, u8 slot,
+				     const u8 *addr)
+{
+	u32 lo, hi, ctrl;
+	int i;
+
+	lo = (addr[2] << 24) | (addr[3] << 16) | (addr[4] << 8) | addr[5];
+	hi = (addr[0] << 8) | addr[1];
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		airoha_fe_wr(eth, REG_UPDMEM_DATA(i), lo);
+		airoha_fe_wr(eth, REG_UPDMEM_CTRL(i),
+			     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, slot) |
+			     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+		read_poll_timeout_atomic(airoha_fe_rr, ctrl,
+					 ctrl & PPE_UPDMEM_ACK_MASK,
+					 1, 100, false, eth,
+					 REG_UPDMEM_CTRL(i));
+
+		airoha_fe_wr(eth, REG_UPDMEM_DATA(i), hi);
+		airoha_fe_wr(eth, REG_UPDMEM_CTRL(i),
+			     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, slot) |
+			     FIELD_PREP(PPE_UPDMEM_OFFSET_MASK, 1) |
+			     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+		read_poll_timeout_atomic(airoha_fe_rr, ctrl,
+					 ctrl & PPE_UPDMEM_ACK_MASK,
+					 1, 100, false, eth,
+					 REG_UPDMEM_CTRL(i));
+	}
+}
+
+static u8 airoha_ppe_get_smac_id(struct airoha_eth *eth, u8 default_id,
+				 const u8 *addr)
+{
+	struct airoha_ppe *ppe = eth->ppe;
+	int i, free_slot = -1;
+	u8 slot;
+
+	if (!ppe || !is_valid_ether_addr(addr))
+		return default_id;
+
+	spin_lock_bh(&ppe->smac_lock);
+
+	if (default_id < AIROHA_PPE_SMAC_NUM &&
+	    ppe->smac_table[default_id].valid &&
+	    ether_addr_equal(ppe->smac_table[default_id].addr, addr)) {
+		slot = default_id;
+		goto out;
+	}
+
+	for (i = 0; i < AIROHA_PPE_SMAC_NUM; i++) {
+		if (ppe->smac_table[i].valid &&
+		    ether_addr_equal(ppe->smac_table[i].addr, addr)) {
+			slot = i;
+			goto out;
+		}
+	}
+
+	for (i = AIROHA_MAX_NUM_GDM_PORTS + 1; i < AIROHA_PPE_SMAC_NUM; i++) {
+		if (!ppe->smac_table[i].valid) {
+			free_slot = i;
+			break;
+		}
+	}
+	if (free_slot < 0) {
+		int base = AIROHA_MAX_NUM_GDM_PORTS + 1;
+		int count = AIROHA_PPE_SMAC_NUM - base;
+
+		free_slot = base + (ppe->smac_next_slot % count);
+		ppe->smac_next_slot = (ppe->smac_next_slot + 1) % count;
+	}
+
+	slot = free_slot;
+	airoha_ppe_write_upd_mem(eth, slot, addr);
+	ether_addr_copy(ppe->smac_table[slot].addr, addr);
+	ppe->smac_table[slot].valid = true;
+out:
+	spin_unlock_bh(&ppe->smac_lock);
+
+	return slot;
+}
+
 static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
@@ -702,6 +784,9 @@ static int airoha_ppe_foe_entry_prepare(
 		mac_info = (struct airoha_foe_mac_info *)l2;
 		mac_info->pppoe_id = data->pppoe.sid;
 	} else {
+		if (smac_id != 0xf && is_valid_ether_addr(data->eth.h_source))
+			smac_id = airoha_ppe_get_smac_id(eth, smac_id,
+							 data->eth.h_source);
 		l2->src_mac_hi = FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID, smac_id) |
 				 FIELD_PREP(AIROHA_FOE_MAC_PPPOE_ID,
 					    data->pppoe.sid);
@@ -1959,20 +2044,22 @@ void airoha_ppe_init_upd_mem(struct airo
 {
 	struct airoha_gdm_port *port = dev->port;
 	struct airoha_eth *eth = dev->eth;
-	u32 val;
+	struct airoha_ppe *ppe = eth->ppe;
+	u8 slot = port->id;
 
-	val = (addr[2] << 24) | (addr[3] << 16) | (addr[4] << 8) | addr[5];
-	airoha_fe_wr(eth, REG_UPDMEM_DATA(0), val);
-	airoha_fe_wr(eth, REG_UPDMEM_CTRL(0),
-		     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, port->id) |
-		     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+	if (slot >= AIROHA_PPE_SMAC_NUM)
+		return;
 
-	val = (addr[0] << 8) | addr[1];
-	airoha_fe_wr(eth, REG_UPDMEM_DATA(0), val);
-	airoha_fe_wr(eth, REG_UPDMEM_CTRL(0),
-		     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, port->id) |
-		     FIELD_PREP(PPE_UPDMEM_OFFSET_MASK, 1) |
-		     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+	if (!ppe) {
+		airoha_ppe_write_upd_mem(eth, slot, addr);
+		return;
+	}
+
+	spin_lock_bh(&ppe->smac_lock);
+	airoha_ppe_write_upd_mem(eth, slot, addr);
+	ether_addr_copy(ppe->smac_table[slot].addr, addr);
+	ppe->smac_table[slot].valid = true;
+	spin_unlock_bh(&ppe->smac_lock);
 }
 
 struct airoha_ppe_dev *airoha_ppe_get_dev(struct device *dev)
@@ -2045,6 +2132,7 @@ int airoha_ppe_init(struct airoha_eth *e
 	ppe->dev.priv = ppe;
 	ppe->eth = eth;
 	eth->ppe = ppe;
+	spin_lock_init(&ppe->smac_lock);
 
 	ppe_num_entries = airoha_ppe_get_total_num_entries(ppe);
 	foe_size = ppe_num_entries * sizeof(struct airoha_foe_entry);
