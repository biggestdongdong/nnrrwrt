#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Apply /etc/config/nnrrwrt_advanced.
#
# throttle_temp  Temperature in degrees Celsius of the passive trips of the CPU
#                thermal zones. It is written to the trip_point_N_temp files at
#                every start and reload and takes effect at once.
# dying_gasp     0 puts dying_gasp=0 on the airoha-xpon line of
#                /etc/modules.conf. The module reads the parameter when it
#                loads, so a change takes effect at the next boot.
# crashlog_keep  Read by /etc/init.d/crashlog at boot.
# tcp_congestion_control
#                TCP congestion control algorithm written to
#                /proc/sys/net/ipv4/tcp_congestion_control at start and reload.
#

# shellcheck disable=SC2034
START=19
# shellcheck disable=SC2034
USE_PROCD=1

THERMAL_DIR="/sys/class/thermal"
MODULES_CONF="/etc/modules.conf"
TCP_CONG_FILE="/proc/sys/net/ipv4/tcp_congestion_control"
TCP_CONG_AVAIL_FILE="/proc/sys/net/ipv4/tcp_available_congestion_control"
THROTTLE_MIN=60
THROTTLE_MAX=110

# Rewrite the airoha-xpon line: drop dying_gasp=, add dying_gasp=0 when off=1.
XPON_AWK='
$1 == "options" && $2 == "airoha-xpon" && $0 !~ /#/ {
	line = "options airoha-xpon"
	for (i = 3; i <= NF; i++)
		if ($i !~ /^dying_gasp=/)
			line = line " " $i
	if (off == 1 && !done) {
		line = line " dying_gasp=0"
		done = 1
	}
	if (line != "options airoha-xpon")
		print line
	next
}
{ print }
END {
	if (off == 1 && !done)
		print "options airoha-xpon dying_gasp=0"
}
'

log_warn() {
	logger -t nnrrwrt_advanced -p daemon.warn "$*"
}

is_throttle_temp() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge "$THROTTLE_MIN" ] && [ "$1" -le "$THROTTLE_MAX" ]
}

apply_throttle_temp() {
	local temp="$1" zone trip file

	if ! is_throttle_temp "$temp"; then
		log_warn "throttle_temp '$temp' is not a number from $THROTTLE_MIN to $THROTTLE_MAX, trips unchanged"
		return 0
	fi

	for zone in "$THERMAL_DIR"/thermal_zone*; do
		case "$(cat "$zone/type" 2>/dev/null)" in
			cpu-thermal|cpu-die-thermal) ;;
			*) continue ;;
		esac

		for trip in "$zone"/trip_point_*_type; do
			[ -e "$trip" ] || continue
			[ "$(cat "$trip" 2>/dev/null)" = "passive" ] || continue
			file="${trip%_type}_temp"
			[ -w "$file" ] || continue
			printf '%s\n' "$((temp * 1000))" > "$file" 2>/dev/null ||
				log_warn "cannot write $file"
		done
	done
}

apply_dying_gasp() {
	local enabled="$1" off=0 tmp

	[ "$enabled" -eq 1 ] || off=1
	[ -e "$MODULES_CONF" ] || [ "$off" -eq 1 ] || return 0

	tmp="$(mktemp /tmp/nnrrwrt_advanced.XXXXXX)" || return 0
	{ [ -f "$MODULES_CONF" ] && cat "$MODULES_CONF"; true; } |
		awk -v off="$off" "$XPON_AWK" > "$tmp"

	if [ ! -e "$MODULES_CONF" ] ||
	   [ "$(cat "$tmp")" != "$(cat "$MODULES_CONF")" ]; then
		cat "$tmp" > "$MODULES_CONF" || log_warn "cannot write $MODULES_CONF"
	fi
	rm -f "$tmp"
}

is_tcp_cong_name() {
	case "$1" in
		''|*[!a-zA-Z0-9_-]*) return 1 ;;
	esac
	return 0
}

tcp_cong_available() {
	local target="$1" item avail

	[ -r "$TCP_CONG_AVAIL_FILE" ] || return 1
	avail="$(cat "$TCP_CONG_AVAIL_FILE" 2>/dev/null)" || return 1
	for item in $avail; do
		[ "$item" = "$target" ] && return 0
	done
	return 1
}

apply_tcp_cong() {
	local cong="$1"

	[ -w "$TCP_CONG_FILE" ] || return 0

	if ! is_tcp_cong_name "$cong"; then
		log_warn "tcp_congestion_control '$cong' is invalid, congestion control unchanged"
		return 0
	fi

	if ! tcp_cong_available "$cong"; then
		modprobe "tcp_${cong}" 2>/dev/null || true
	fi

	if ! tcp_cong_available "$cong"; then
		log_warn "tcp_congestion_control '$cong' is not available, congestion control unchanged"
		return 0
	fi

	printf '%s\n' "$cong" > "$TCP_CONG_FILE" 2>/dev/null ||
		log_warn "cannot write $TCP_CONG_FILE"
}

apply_config() {
	local throttle_temp dying_gasp tcp_cong

	config_load nnrrwrt_advanced
	config_get throttle_temp main throttle_temp 95
	config_get_bool dying_gasp main dying_gasp 1
	config_get tcp_cong main tcp_congestion_control
	[ -n "$tcp_cong" ] || config_get tcp_cong main tcp_cong bbr

	apply_throttle_temp "$throttle_temp"
	apply_dying_gasp "$dying_gasp"
	apply_tcp_cong "$tcp_cong"
}

start_service() {
	apply_config
}

reload_service() {
	apply_config
}

service_triggers() {
	procd_add_reload_trigger "nnrrwrt_advanced"
}
